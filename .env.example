# ============================================================
# CryptoStream Realtime — Environment Variables
# Copy to .env and fill in values
# ============================================================

# ---------- General ----------
CRYPTOSTREAM_ENV=dev
CRYPTOSTREAM_LOG_LEVEL=INFO

# ---------- Binance ----------
CRYPTOSTREAM_BINANCE_WS_URL=wss://stream.binance.com:9443/ws
CRYPTOSTREAM_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
CRYPTOSTREAM_STREAMS=aggTrade,depth@100ms

# ---------- Kafka ----------
CRYPTOSTREAM_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CRYPTOSTREAM_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
CRYPTOSTREAM_KAFKA_ACKS=all
CRYPTOSTREAM_KAFKA_TRADES_TOPIC=crypto.trades.v1
CRYPTOSTREAM_KAFKA_ORDERBOOK_TOPIC=crypto.orderbook.v1

# ---------- Spark ----------
CRYPTOSTREAM_SPARK_MASTER=spark://spark-master:7077
CRYPTOSTREAM_SPARK_CHECKPOINT_DIR=s3a://cryptostream-dev-checkpoints/

# ---------- S3 / MinIO ----------
CRYPTOSTREAM_S3_ENDPOINT=http://minio:9000
CRYPTOSTREAM_S3_ACCESS_KEY=minioadmin
CRYPTOSTREAM_S3_SECRET_KEY=minioadmin
CRYPTOSTREAM_S3_BRONZE_BUCKET=cryptostream-dev-bronze
CRYPTOSTREAM_S3_SILVER_BUCKET=cryptostream-dev-silver
CRYPTOSTREAM_S3_GOLD_BUCKET=cryptostream-dev-gold

# ---------- AWS (prod) ----------
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=123456789012

# ---------- Schema Registry (optional) ----------
# CRYPTOSTREAM_SCHEMA_REGISTRY_URL=http://schema-registry:8081
